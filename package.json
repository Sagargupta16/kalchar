{
	"name": "kalchar-by-megha",
	"version": "1.39.0",
	"private": true,
	"description": "Portfolio site for Megha Seth, traditional folk artist.",
	"license": "UNLICENSED",
	"packageManager": "pnpm@10.32.0",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "next dev --turbopack",
		"dev:preview": "node scripts/admin-preview.mjs",
		"build": "next build",
		"start": "next start",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"lint:ui": "node scripts/check-ui-tokens.mjs",
		"format": "biome format --write",
		"typecheck": "tsc --noEmit",
		"typecheck:scripts": "tsc --project tsconfig.scripts.json",
		"typecheck:tests": "tsc --project tests/admin/tsconfig.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"test:operations": "node --test scripts/operational.test.mjs",
		"test:all": "pnpm test && pnpm test:e2e",
		"health": "node scripts/health-check.mjs",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:validate": "node scripts/check-migrations.mjs",
		"db:check": "tsx scripts/check-migrations-db.ts",
		"db:seed": "tsx --env-file-if-exists=.env.local scripts/migrate-json-to-db.ts",
		"db:images": "tsx --env-file=.env.local scripts/migrate-images-to-r2.ts",
		"r2:cors": "tsx --env-file=.env.local scripts/set-r2-cors.ts",
		"r2:cleanup": "tsx --env-file-if-exists=.env.local scripts/cleanup-staging.ts"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1123.0",
		"@aws-sdk/s3-request-presigner": "^3.1123.0",
		"@neondatabase/serverless": "^1.1.0",
		"@vercel/analytics": "^2.0.1",
		"@vercel/speed-insights": "^2.0.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.2",
		"lenis": "^1.3.25",
		"lucide-react": "^1.24.0",
		"motion": "^12.42.2",
		"next": "^16.3.5",
		"next-auth": "5.0.0-beta.32",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-icons": "^5.7.0",
		"sharp": "^0.35.4",
		"tailwind-merge": "^3.6.0"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.12.1",
		"@biomejs/biome": "^2.5.3",
		"@electric-sql/pglite": "^0.5.8",
		"@playwright/test": "^1.61.1",
		"@tailwindcss/postcss": "^4.3.2",
		"@types/node": "^22.19.19",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.0.0",
		"dotenv": "^17.4.2",
		"drizzle-kit": "^0.31.10",
		"esbuild": "^0.28.1",
		"pg": "^8.23.0",
		"postcss": "^8.5.23",
		"tailwindcss": "^4.3.2",
		"tsx": "^4.23.1",
		"typescript": "^6.0.3",
		"vitest": "^4.1.11",
		"zxing-wasm": "^3.1.4"
	}
}
