{
	"name": "kalchar-by-megha",
	"version": "1.41.0",
	"private": true,
	"description": "Portfolio site for Megha Seth, traditional folk artist.",
	"license": "UNLICENSED",
	"packageManager": "pnpm@10.34.6",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "next dev --turbopack",
		"dev:preview": "node scripts/admin-preview.mjs",
		"build": "next build",
		"start": "next start",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"format": "biome format --write",
		"typecheck": "next typegen && tsc --noEmit",
		"typecheck:scripts": "tsc --project tsconfig.scripts.json",
		"typecheck:tests": "tsc --project tests/admin/tsconfig.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"test:e2e:fixtures": "node scripts/e2e-fixtures.mjs",
		"test:preview": "node scripts/e2e-fixtures.mjs --preview",
		"test:operations": "node --test scripts/operational.test.mjs",
		"test:all": "pnpm test && pnpm test:e2e",
		"health": "node scripts/health-check.mjs",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:validate": "node scripts/check-migrations.mjs",
		"db:check": "tsx scripts/check-migrations-db.ts",
		"db:seed": "tsx --env-file-if-exists=.env.local scripts/migrate-json-to-db.ts",
		"db:images": "tsx --env-file-if-exists=.env.local scripts/migrate-images-to-r2.ts",
		"r2:cors": "tsx --env-file-if-exists=.env.local scripts/set-r2-cors.ts",
		"r2:cleanup": "tsx --env-file-if-exists=.env.local scripts/cleanup-staging.ts"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1156.0",
		"@aws-sdk/s3-request-presigner": "^3.1156.0",
		"@neondatabase/serverless": "^1.2.0",
		"@vercel/analytics": "^2.0.1",
		"@vercel/speed-insights": "^2.0.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.4",
		"lenis": "^1.3.27",
		"lucide-react": "^1.61.0",
		"motion": "^14.6.0",
		"next": "^16.4.3",
		"next-auth": "5.0.0-beta.32",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-icons": "^5.7.0",
		"sharp": "^0.35.5",
		"tailwind-merge": "^3.7.0"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@biomejs/biome": "^2.6.2",
		"@electric-sql/pglite": "^0.5.11",
		"@playwright/test": "^1.64.1",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/node": "^24.19.2",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"dotenv": "^18.0.9",
		"drizzle-kit": "^0.31.11",
		"esbuild": "^0.28.2",
		"pg": "^8.23.1",
		"postcss": "^8.5.31",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"vitest": "^5.0.5",
		"zxing-wasm": "^3.1.6"
	}
}
